# Copy to .env.local for local development, and add the same values in the
# Vercel project under Settings -> Environment Variables.

# Required. The GitHub account the portfolio pulls its repositories from.
NEXT_PUBLIC_GITHUB_USERNAME=

# Optional but recommended. A fine-grained token with public read access only.
# Without it the build shares GitHub's 60 requests/hour anonymous rate limit,
# which is easy to exhaust on a busy Vercel project. With it, 5000/hour.
GITHUB_TOKEN=

# Optional. Canonical site URL, used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=
